# Copy to .env only if your shell or environment loader reads dotenv files.
# The application itself reads these values from the process environment.
LEARNABLE_SDE_DATA_ROOT=/absolute/path/to/trajectory-data
LEARNABLE_SDE_COND_ROOT=/absolute/path/to/condition-data
LEARNABLE_SDE_CHECKPOINT=/absolute/path/to/checkpoint-directory
LEARNABLE_SDE_OUTPUT_ROOT=/absolute/path/to/output-directory
