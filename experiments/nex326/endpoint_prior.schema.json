{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex326-endpoint-prior-v1",
  "type": "object",
  "required": ["schema_version", "feed_id", "data_version", "independence_attestation", "records"],
  "properties": {
    "schema_version": {"const": "nex326-endpoint-prior-v1"},
    "feed_id": {"type": "string", "minLength": 1},
    "data_version": {"type": "string", "minLength": 1},
    "independence_attestation": {
      "type": "object",
      "required": ["derived_from_evaluation_truth", "method", "responsible_party"],
      "properties": {
        "derived_from_evaluation_truth": {"const": false},
        "method": {"type": "string", "minLength": 1},
        "responsible_party": {"type": "string", "minLength": 1}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "mean", "covariance"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "mean": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number"}
          },
          "covariance": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
