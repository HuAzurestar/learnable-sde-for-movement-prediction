{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nex326-endpoint-prior-request-v1",
  "type": "object",
  "required": [
    "schema_version",
    "purpose",
    "cohort",
    "state_space",
    "inference_cut_rule",
    "record_count",
    "provider_requirements",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "nex326-endpoint-prior-request-v1"},
    "purpose": {"const": "independent_endpoint_prior_generation"},
    "cohort": {
      "type": "object",
      "required": ["dataset_id", "data_version", "fingerprint", "file", "sha256"]
    },
    "state_space": {"const": "cohort_native_2d_xy"},
    "inference_cut_rule": {"const": "max(1, segment_length // 2 - 1)"},
    "record_count": {"type": "integer", "minimum": 1},
    "provider_requirements": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "source_domain",
          "region",
          "observed_time",
          "observed_state",
          "observed_conditions",
          "forecast_horizon"
        ],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "source_domain": {"type": "string", "minLength": 1},
          "region": {"type": "string"},
          "observed_time": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "number"}
          },
          "observed_state": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            }
          },
          "observed_conditions": {"type": "object"},
          "forecast_horizon": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
